#
# Build-time settings for the web. Copy to apps/web/.env.local for local
# development (ignored by git).

# Official signaling server. Users can still switch to their own server
# from the UI. Local development: ws://127.0.0.1:8090/ws
VITE_SIGNAL_URL=wss://signal.go-link.org/ws

# true shows the design's sample data (rooms, players, chat) instead of
# live data, for screenshots and visual checks.
VITE_DEMO_DATA=false

# Willy Maker's own site, which reaches the device through this site's
# /maker-bridge tab. Default: http://localhost:5181 in development,
# https://maker.go-link.org in a build.
# VITE_MAKER_URL=https://maker.go-link.org
