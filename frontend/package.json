{
  "name": "go-link-frontend",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*",
    "willy-maker"
  ],
  "scripts": {
    "dev": "npm run dev -w @go-link/web",
    "build": "npm run build -w @go-link/web",
    "test": "vitest run",
    "typecheck": "tsc -p packages/shared && tsc -p packages/ui && tsc -p packages/cps1 && tsc -p packages/cps1-sim && tsc -p apps/web && tsc -p willy-maker",
    "dev:maker": "npm run dev -w @go-link/willy-maker",
    "build:maker": "npm run build -w @go-link/willy-maker"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.2",
    "jsdom": "^30.1.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=22.22.2"
  }
}
