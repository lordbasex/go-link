// Shared build settings. Your Apple team goes in Local.xcconfig (gitignored,
// copy Local.xcconfig.example): nothing about signing is committed.
MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1
CODE_SIGN_STYLE = Automatic
DEVELOPMENT_TEAM =
// Universal Links (Associated Domains). A free personal team cannot sign it:
// Local.xcconfig can set GOLINK_ENTITLEMENTS = (empty) to leave it out.
GOLINK_ENTITLEMENTS = GoLinkPlayer/GoLinkPlayer.entitlements
#include? "Local.xcconfig"
