+// Copyright (c) 2026 Federico Pereira <lord.basex@gmail.com>
+// Reads a Willy Maker AI pack (PROMPT.md, project.json, levels/<id>.tmj
+// with its layer pictures) into what the CPS-1 build needs: the level's
+// tiles cut from the play and far pictures (deduplicated, one 15-color
+// palette per layer), the collision cells, the objects with their
+// properties and the game settings (title, texts, players, DIP switches).
+//
+//   build.mjs --pack DIR  -> art.mjs addPackArt() -> gen/art_data.c
+
+import fs from "node:fs";
+import path from "node:path";
+import { readPng } from "./png.mjs";
+
+// collision codes shared with the 68000 program (lab_state.h's col_map legend)
+export const CELL = { EMPTY: 0, SOLID: 1, ONEWAY: 2, LADDER: 3, CRATE: 4 };
+// the pack's tags (tilesets[].tiles[].type) to our cells; the ones the
+// engine does not have yet are refused rather than silently dropped
+const TAGS = { solid: CELL.SOLID, oneway: CELL.ONEWAY, ladder: CELL.LADDER, crate: CELL.CRATE };
+
+const prop = (o, name, dflt) => {
+  const p = (o.properties || []).find((q) => q.name === name);
+  return p ? p.value : dflt;
+};
+
+/** The pack's first level, ready for the build. */
+export function readPack(dir) {
+  const project = JSON.parse(fs.readFileSync(path.join(dir, "project.json"), "utf8"));
+  const settings = project.settings;
+  const levelId = settings.levels[0];
+  if (settings.levels.length !== 1) throw new Error(`pack: ${settings.levels.length} levels, this build plays one`);
+  const tmj = JSON.parse(fs.readFileSync(path.join(dir, "levels", `${levelId}.tmj`), "utf8"));
+  if (tmj.tilewidth !== 16 || tmj.tileheight !== 16) throw new Error("pack: the play grid must be 16 px");
+  const cols = tmj.width;
+  const rows = tmj.height;
+  const layer = (name) => tmj.layers.find((l) => l.name === name);
+
+  // collision: the tag tileset's gids to cells
+  const tagSet = tmj.tilesets.find((t) => t.name === "collision");
+  const tagOf = new Map(tagSet.tiles.map((t) => [tagSet.firstgid + t.id, t.type]));
+  const col = layer("collision").data.map((gid) => {
+    if (!gid) return CELL.EMPTY;
+    const tag = tagOf.get(gid);
+    if (!(tag in TAGS)) throw new Error(`pack: collision tag "${tag}" is not in the engine yet`);
+    return TAGS[tag];
+  });
+
+  // objects, by type
+  const objs = layer("objects").objects;
+  const ofType = (t) => objs.filter((o) => o.type === t);
+  const starts = ofType("player_start")
+    .map((o) => ({ player: prop(o, "player", 1), x: o.x, y: o.y }))
+    .sort((a, b) => a.player - b.player);
+  const exits = ofType("exit");
+  if (exits.length !== 1) throw new Error(`pack: ${exits.length} exits, the engine has one`);
+  const crates = ofType("crate").map((o) => {
+    const size = prop(o, "size", 32);
+    if (size !== 32) throw new Error(`pack: crate ${o.name} is ${size} px, the engine has 32 px crates`);
+    if (prop(o, "contents", "nothing") !== "nothing") throw new Error(`pack: crate ${o.name} holds something, not built yet`);
+    return { name: o.name, c: o.x / 16, r: o.y / 16, hp: prop(o, "hp", 3) };
+  });
+  for (const k of crates)
+    for (let q = 0; q < 4; q++)
+      if (col[(k.r + (q >> 1)) * cols + k.c + (q & 1)] !== CELL.CRATE) throw new Error(`pack: crate ${k.name} is not on crate cells`);
+  const enemies = ofType("enemy").map((o) => {
+    const patrol = prop(o, "patrol", 96);
+    return { name: o.name, kind: prop(o, "kind", "trooper"), x: o.x, y: o.y, min: o.x - patrol / 2, max: o.x + patrol / 2, facing: prop(o, "facing", "left") === "left" ? -1 : 1 };
+  });
+  const civilians = ofType("civilian").map((o) => ({ name: o.name, x: o.x, y: o.y, child: prop(o, "kind", "woman") === "child" ? 1 : 0 }));
+
+  // pictures: the play layer on scroll2 (16 px), the far one on scroll3 (32 px)
+  const levelDir = path.join(dir, "levels", levelId);
+  const play = readPng(fs.readFileSync(path.join(levelDir, "play.png")));
+  const far = readPng(fs.readFileSync(path.join(levelDir, "far.png")));
+  if (play.w !== cols * 16 || play.h !== rows * 16) throw new Error("pack: play.png does not match the map");
+
+  const props = Object.fromEntries((tmj.properties || []).map((p) => [p.name, p.value]));
+  const lv = project.levels.find((l) => l.id === levelId);
+  return {
+    project,
+    settings,
+    title: project.title,
+    credits: settings.credits || "",
+    texts: Object.fromEntries(Object.entries(settings.menus || {}).map(([k, m]) => [k, m.texts || {}])),
+    dip: settings.dip,
+    players: settings.players,
+    level: {
+      id: levelId,
+      name: props.level_name || lv?.name || levelId,
+      cols,
+      rows,
+      col,
+      backtrack: props.camera_backtrack ?? lv?.camera?.backtrack ?? 48,
+      parallax: layer("far")?.parallaxx ?? 0.5,
+      starts,
+      exit: { x: exits[0].x, y: exits[0].y, w: 32 },
+      crates,
+      enemies,
+      civilians,
+      play,
+      far,
+    },
+  };
+}
+
+/** The colors of a picture (opaque pixels), as [r,g,b]. */
+export function pictureColors(img) {
+  const seen = new Map();
+  for (let i = 0; i < img.w * img.h; i++) {
+    if (!img.rgba[i * 4 + 3]) continue;
+    const k = (img.rgba[i * 4] << 16) | (img.rgba[i * 4 + 1] << 8) | img.rgba[i * 4 + 2];
+    seen.set(k, (seen.get(k) || 0) + 1);
+  }
+  // most used first, so the palette's order is stable
+  return [...seen.entries()].sort((a, b) => b[1] - a[1] || a[0] - b[0]).map(([k]) => [(k >> 16) & 255, (k >> 8) & 255, k & 255]);
+}
+
+/**
+ * Cuts a picture into size x size tiles with one palette (the picture's
+ * own colors, at most 15: Willy Maker exports in board colors). Returns
+ * the tile code of every cell (deduplicated, the empty tile shared).
+ */
+export function cutTiles(img, size, palette, baseCode, write) {
+  const index = new Map(palette.map((c, i) => [(c[0] << 16) | (c[1] << 8) | c[2], i]));
+  const cols = Math.ceil(img.w / size);
+  const rows = Math.ceil(img.h / size);
+  const seen = new Map();
+  const map = [];
+  let next = baseCode;
+  // the empty tile first (baseCode): broken crates turn into it
+  const blank = Array.from({ length: size }, () => new Array(size).fill(15));
+  seen.set(blank.map((r) => r.join(",")).join(";"), next);
+  write(next++, blank);
+  for (let ty = 0; ty < rows; ty++)
+    for (let tx = 0; tx < cols; tx++) {
+      const px = Array.from({ length: size }, (_, y) =>
+        Array.from({ length: size }, (_, x) => {
+          const sx = tx * size + x;
+          const sy = ty * size + y;
+          if (sx >= img.w || sy >= img.h) return 15;
+          const o = (sy * img.w + sx) * 4;
+          if (!img.rgba[o + 3]) return 15;
+          const pen = index.get((img.rgba[o] << 16) | (img.rgba[o + 1] << 8) | img.rgba[o + 2]);
+          if (pen === undefined) throw new Error(`pack: a color at ${sx},${sy} is not in the palette`);
+          return pen;
+        }),
+      );
+      const key = px.map((r) => r.join(",")).join(";");
+      let code = seen.get(key);
+      if (code === undefined) {
+        code = next++;
+        seen.set(key, code);
+        write(code, px);
+      }
+      map.push(code);
+    }
+  return { map, cols, rows, unique: seen.size };
+}
