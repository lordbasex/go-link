;
; The sound CPU's program for the prototype: interrupts off, then wait
; forever. The 68000's sound commands stay in the latch unread. A real
; sound driver (YM2151 music, OKI samples) comes later.

	org 0
	di
	ld sp, 0xd7f0
idle:
	jr idle
