{
  "name": "go-link-e2e",
  "private": true,
  "description": "End-to-end tests: a real browser against a real signalhub, device and website",
  "type": "module",
  "scripts": {
    "test": "playwright test --project=web",
    "test:android": "E2E_DEVICE_DEBUG=1 playwright test --project=android",
    "shots": "E2E_SHOTS=1 playwright test --project=shots",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.57.0"
  }
}
